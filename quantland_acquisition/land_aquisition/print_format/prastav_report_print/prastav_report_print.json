 "html": "<!DOCTYPE html>\n<html lang=\"mr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Kanthi Vibhag 1 Valuation Report</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 5mm;\n    }\n    .print-format {\n      width: 100%;\n      font-size: 12pt;\n      -webkit-print-color-adjust: exact;\n    }\n    table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 11pt;\n      margin-bottom: 5mm;\n    }\n    th, td {\n      border: 1px solid black;\n      padding: 4px;\n      text-align: left;\n    }\n    th {\n      background-color: #f0f0f0;\n      font-weight: bold;\n      text-align: center;\n    }\n    .text-center {\n      text-align: center;\n    }\n    .page-break {\n      page-break-after: always;\n    }\n  </style>\n</head>\n<body>\n\n{% for row in data %}\n<div class=\"print-format\">\n  <h2 class=\"text-center\">\u0935\u093f\u092d\u093e\u0917\u0940\u092f \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0905\u0939\u0935\u093e\u0932</h2>\n  <p><b>\u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0906\u092f\u0921\u0940:</b> {{ row[0] }} &nbsp;&nbsp; <b>\u0917\u093e\u0935\u093e\u091a\u0947 \u0928\u093e\u0935:</b> {{ row[1] }} &nbsp;&nbsp; <b>\u0924\u0939\u0938\u0940\u0932:</b> {{ row[2] }} &nbsp;&nbsp; <b>\u091c\u093f\u0932\u094d\u0939\u093e:</b> {{ row[3] }}</p>\n\n  <table>\n    <thead>\n      <tr>\n        <th>\u0917\u091f \u0915\u094d\u0930\u092e\u093e\u0902\u0915</th>\n        <th>\u0917\u094d\u0930\u0941\u092a \u0915\u094d\u0930\u092e\u093e\u0902\u0915</th>\n        <th>\u096d/\u0967\u0968 \u0928\u094b\u0902\u0926</th>\n        <th>\u0938\u0902\u092a\u093e\u0926\u0928\u093e\u091a\u093e \u092a\u094d\u0930\u0915\u093e\u0930</th>\n        <th>\u090f\u0915\u0942\u0923 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u092b\u0933</th>\n        <th>\u0936\u0947\u0924\u0940\u0938\u093e\u0920\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u092b\u0933</th>\n        <th>\u092a\u094b\u091f \u0916\u0930\u093e\u092c</th>\n        <th>\u0938\u0902\u092a\u093e\u0926\u0928 \u0915\u0930\u093e\u0935\u092f\u093e\u091a\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930</th>\n        <th>\u096d/\u0967\u0968 \u0928\u0941\u0938\u093e\u0930 \u0906\u0915\u093e\u0930</th>\n        <th>\u0939\u0947\u0915\u094d\u091f\u0947\u0905\u0930 \u0906\u0915\u093e\u0930</th>\n        <th>\u091c\u092e\u093f\u0928\u0940\u091a\u0940 \u092a\u094d\u0930\u0924\u0935\u093e\u0930\u0940</th>\n        <th>\u091c\u093f\u0932\u094d\u0939\u093e \u0938\u094d\u0924\u0930 \u0938\u092e\u093f\u0924\u0940\u0926\u094d\u0935\u093e\u0930\u0947 \u0939\u0947\u0915\u094d\u091f\u0947\u0905\u0930 \u0926\u0930</th>\n        <th>\u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u091c\u092e\u093f\u0928\u0940\u091a\u0947 \u092e\u0942\u0932\u094d\u092f</th>\n        <th>\u0917\u0941\u0923\u0915</th>\n        <th>\u0917\u0941\u0923\u0915\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u091c\u092e\u0940\u0928 \u0915\u093f\u0902\u092e\u0924</th>\n        <th>\u091d\u093e\u0921\u093e\u0902\u0935\u0930\u0940\u0932 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928</th>\n        <th>\u0935\u093f\u0939\u0940\u0930/\u092a\u093e\u0907\u092a\u0932\u093e\u0907\u0928\u0935\u0930\u0940\u0932 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928</th>\n        <th>\u0918\u0930\u093e\u0902\u0935\u0930\u0940\u0932 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928</th>\n        <th>\u0907\u0924\u0930 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928</th>\n        <th>\u092e\u093e\u0932\u092e\u0924\u094d\u0924\u0947\u091a\u0947 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 (\u0925\u0947\u091f \u0916\u0930\u0947\u0926\u0940)</th>\n        <th>\u090f\u0915\u0942\u0923 \u092e\u0942\u0932\u094d\u092f (\u0917\u0941\u0923\u0915 \u0935 \u0925\u0947\u091f \u0916\u0930\u0947\u0926\u0940)</th>\n        <th>\u0967\u0966\u0966% \u0938\u0935\u0932\u0924 \u0930\u0915\u094d\u0915\u092e</th>\n        <th>\u090f\u0915\u0942\u0923 \u0930\u0915\u094d\u0915\u092e</th>\n        <th>\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0930\u0915\u094d\u0915\u092e (\u0968\u096b%) \u0936\u093e\u0938\u0928\u093e\u0926\u094d\u0935\u093e\u0930\u0947</th>\n        <th>\u090f\u0915\u0942\u0923 \u092e\u094b\u092c\u0926\u0932\u093e \u0930\u0915\u094d\u0915\u092e</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        {% for i in range(5, 30) %}\n        <td>{{ row[i] }}</td>\n        {% endfor %}\n      </tr>\n    </tbody>\n  </table>\n\n  <p><b>\u0924\u093e\u0930\u0940\u0916:</b> {{ row[35] }} &nbsp;&nbsp; <b>\u0936\u0947\u0930\u093e:</b> {{ row[36] }}</p>\n</div>\n\n<div class=\"page-break\"></div>\n{% endfor %}\n\n</body>\n</html>\n",
